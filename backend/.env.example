# ===== 豆包（火山方舟 Ark）API 配置 =====
# 复制本文件为 .env 并填入真实密钥，.env 不要提交到 Git
# 密钥申请地址：https://console.volcengine.com/ark

# 火山方舟 API Key
ARK_API_KEY=your_doubao_ark_api_key_here

# 火山方舟接口基础地址（OpenAI 兼容模式）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 对话模型：填写推理接入点 ID（ep-xxxx）或模型名称，如 doubao-pro-32k
CHAT_MODEL=doubao-pro-32k

# 向量化模型：填写 Embedding 推理接入点 ID（ep-xxxx）或模型名称
# 建议使用推理接入点，可避免模型版本下线导致按名称调用失败
EMBEDDING_MODEL=doubao-embedding-text-240715

# 向量化接口形态（重要）：
#   text       标准 /embeddings 接口，支持批量，适用于 doubao-embedding-text-*
#   multimodal /embeddings/multimodal 接口，整批融合成一条向量，
#              适用于 doubao-embedding-vision-* 等多模态模型（每个文本块单独请求）
#   auto       先试标准接口，模型不支持时自动回退多模态
EMBEDDING_MODE=auto

# multimodal 模式下的并发请求数
EMBEDDING_CONCURRENCY=8

# ===== RAG 参数（可选，有默认值）=====
# 向量库 / 上传文件 / 评测记录 的本地存储目录
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
EVAL_FILE=./data/evaluations.jsonl

# 文本切块大小（字符数）与重叠长度
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 检索 Top-K 片段数量
TOP_K=3

# 相似度阈值（Chroma 使用余弦距离，值越小越相似，大于该阈值判定为不相关 -> 触发拒答）
RELEVANCE_THRESHOLD=0.45
