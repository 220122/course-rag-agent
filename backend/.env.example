# ============================================================
#  课程知识问答 RAG 智能体 - 环境变量示例
#  复制本文件为 .env 并填入真实配置；.env 已被 .gitignore 排除，不要提交
#
#  【重要】对话模型与向量化模型是两个独立可切换的部件：
#    - DeepSeek 官方只提供对话接口，没有 embedding 接口，
#      而 RAG 必须有向量化，所以向量化只能另选。
#    - 默认组合：DeepSeek 答题 + 本地离线模型做向量化（零 API 成本）
# ============================================================

# ============ 一、对话模型（负责答题）============
# deepseek => DeepSeek 官方接口（默认）    ark => 火山方舟（豆包）
CHAT_PROVIDER=deepseek

# DeepSeek 模型名：deepseek-flash（快、便宜） 或 deepseek-v4-pro（更强）
# 注意：旧的 deepseek-chat / deepseek-reasoner 已不在官方文档中，可能不可用
CHAT_MODEL=deepseek-flash

# 是否开启思考模式。RAG 问答的答案已被检索资料约束，开启只会明显增加延迟
CHAT_THINKING=false

# DeepSeek API Key（申请：https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com


# ============ 二、向量化模型（负责检索）============
# local => 本地离线模型，不消耗任何 API 额度，无需 Key（默认）
# ark   => 火山方舟向量化接口
# ⚠️ 切换 provider 会改变向量维度，必须清空并重建知识库
EMBEDDING_PROVIDER=local

# 本地模型（HuggingFace 模型 ID 或本地路径）。bge-small-zh-v1.5 面向中文检索
# 想提升效果可换成 BAAI/bge-base-zh-v1.5 或 BAAI/bge-large-zh-v1.5（更大更慢）
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型缓存目录，首次使用会自动下载到这里，之后可完全离线
LOCAL_EMBEDDING_CACHE_DIR=./data/models


# ============ 三、火山方舟（仅当上面选了 ark 时才需要）============
# 密钥申请地址：https://console.volcengine.com/ark
ARK_API_KEY=your_doubao_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 向量化接入点 ID（ep-xxxx）或模型名。建议用推理接入点，
# 可避免模型版本「即将下线」后按名称调用失败
ARK_EMBEDDING_MODEL=

# 向量化接口形态：
#   text       标准 /embeddings 接口，支持批量，适用于 doubao-embedding-text-*
#   multimodal /embeddings/multimodal 接口，整批融合成一条向量，
#              适用于 doubao-embedding-vision-* 等多模态模型（每个文本块单独请求）
#   auto       先试标准接口，模型不支持时自动回退多模态
EMBEDDING_MODE=auto
# multimodal 模式下的并发请求数
EMBEDDING_CONCURRENCY=8


# ============ 四、本地存储路径 ============
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
EVAL_FILE=./data/evaluations.jsonl


# ============ 五、RAG 参数 ============
# 文本切块大小（字符数）与重叠长度
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 检索 Top-K 片段数量。教材类大知识库建议 6~8：
# 答案常分散在多个片段里，取 3 容易只覆盖一部分。实测「文件的物理结构有哪几种？」
# 在 TOP_K=3 时检索到的全是「逻辑结构」片段导致答不出，提到 6 以上即可完整列出三种。
# 注意：调大 TOP_K 不会削弱拒答能力——拒答由 RELEVANCE_THRESHOLD 控制，与 TOP_K 无关。
TOP_K=8

# 相关性阈值：Chroma 使用余弦距离（0 完全相同），大于该阈值的片段判定为不相关 -> 触发拒答
# ⚠️ 该阈值与所用向量化模型强相关，更换模型后必须重新校准（见 README 第八节）
RELEVANCE_THRESHOLD=0.52
